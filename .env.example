# Copy to .env for local use. Never put real values in source control.
HOST=127.0.0.1
PORT=3001

# Optional OpenAI-compatible chat-completions endpoint. Leave blank for demo mode.
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=replace-with-your-model
AI_API_KEY=

# PayPal Sandbox only. The application never supports live.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=