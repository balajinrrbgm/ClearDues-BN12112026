# Copy to .env for local use. Never put real values in source control.
HOST=127.0.0.1
PORT=3001

# Microsoft Foundry project endpoint and resource API key. Leave blank for demo mode.
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL_DEPLOYMENT=gpt-6.1-terra

# PayPal Sandbox only. The application never supports live.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=